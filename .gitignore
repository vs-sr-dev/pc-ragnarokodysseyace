# ECH tables ship as .bin and the actor parameters as .json; both are game
# content. There is no hand-written file of either kind in this repository.
*.bin
*.json
*.otf
*.par
*.dat
*.DAT
EBOOT.BIN
PARAM.SFO
*.self
*.elf

# The disc index is derived from a specific disc and lists its layout;
# the manifest is a fingerprint (path, size, sha256) and IS publishable,
# which is what devilutionX and Ship of Harkinian do.
tools/iso_index.tsv

# Anything a tool here writes out of the disc: a dump of table values, a
# rendered frame, a mesh. The tool is publishable, its output is not.
generated/
*.png
*.obj
*.wav
*.hca
*.adx
*.vag
*.mpg

